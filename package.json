		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/geojson": "^7946.0.16",
		"@types/leaflet": "^1.9.22",
		"daisyui": "^5.7.22",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
